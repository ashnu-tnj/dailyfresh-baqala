# Copy to .env and fill in. Nothing here may be committed.

PORT=8082
# Where the PWA is mounted. Empty = served at the domain root.
BASE_PATH=
# Set only when testing over plain http on localhost; never in production.
# INSECURE_COOKIE=1

# The n8n Console API webhook and its shared key (df_config.console_api_key).
CONSOLE_API_URL=https://n8n.srv1047573.hstgr.cloud/webhook/df/console
CONSOLE_API_KEY=

# Guards POST /api/notify, which the bot workflow calls (df_config.console_admin_token).
ADMIN_TOKEN=

# Signs the session cookie. Any long random string; changing it signs everyone out.
SESSION_SECRET=
SESSION_DAYS=30

# Web Push. Generate once with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@aflatus.com
